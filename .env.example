# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=PayRescue NG
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 17+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payrescue_db?schema=public"

# Redis Configuration (BullMQ / Caching / Rate Limiting)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# JWT & Authentication
JWT_ACCESS_SECRET="payrescue_super_secure_access_secret_key_2026_lagos"
JWT_REFRESH_SECRET="payrescue_super_secure_refresh_secret_key_2026_nigeria"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Evidence Storage Configuration
# Options: local | s3 | cloudinary
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="payrescue-evidence-vault"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paystack Payment Gateway (Nigeria)
PAYSTACK_SECRET_KEY="sk_test_placeholder_payrescue_nigeria"
PAYSTACK_PUBLIC_KEY="pk_test_placeholder_payrescue_nigeria"
PAYSTACK_WEBHOOK_SECRET="whsec_placeholder_payrescue_webhook"

# Email Provider Configuration
# Options: mock | smtp | resend
EMAIL_DRIVER=mock
RESEND_API_KEY=""
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PayRescue Support <support@payrescue.ng>"

# SMS / WhatsApp Configuration (Termii / Twilio Ready)
SMS_DRIVER=mock
TERMII_API_KEY=""
TERMII_SENDER_ID="PayRescue"

# Malware Scanner (ClamAV Integration Interface)
MALWARE_SCANNER_ENABLED=false
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
